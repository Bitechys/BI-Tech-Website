---
/** Team-only picker for the design variants. noindex, excluded from the sitemap, disallowed in robots.txt. */
import { VARIANTS, ACTIVE_VARIANT } from '../../config';
import Logo from '../../components/shared/Logo.astro';
import '../../styles/base.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Design variants · Bi Tech Solutions</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style>
      body { margin: 0; font-family: system-ui, sans-serif; background: #f4f6fb; color: #0e1530; }
      main { max-width: 56rem; margin: 0 auto; padding: 3rem 1rem 4rem; }
      .logo { width: 12rem; height: auto; }
      h1 { font-size: 1.75rem; margin: 2rem 0 0.5rem; }
      p.lead { color: #4a5578; margin: 0 0 2rem; }
      ul { list-style: none; padding: 0; display: grid; gap: 1rem; }
      li { background: #fff; border: 1px solid #dfe4f2; border-radius: 1rem; padding: 1.25rem 1.5rem; display: grid; gap: 0.5rem; }
      h2 { margin: 0; font-size: 1.25rem; display: flex; gap: 0.75rem; align-items: center; }
      .live { font-size: 0.75rem; font-weight: 600; background: #22338e; color: #fff; padding: 0.15rem 0.5rem; border-radius: 99px; }
      .links { display: flex; gap: 1rem; flex-wrap: wrap; }
      a { color: #22338e; font-weight: 600; }
    </style>
  </head>
  <body>
    <main>
      <Logo class="logo" />
      <h1>Design variants</h1>
      <p class="lead">Same content, three directions. The live site uses <strong>{VARIANTS[ACTIVE_VARIANT].name}</strong> (set in <code>src/config.ts</code>).</p>
      <ul>
        {
          Object.entries(VARIANTS).map(([id, v]) => (
            <li>
              <h2>
                {v.name}
                {id === ACTIVE_VARIANT && <span class="live">Live</span>}
              </h2>
              <span>{v.summary}</span>
              <span class="links">
                <a href={`/preview/${id}/`}>English</a>
                <a href={`/preview/${id}/ar/`} lang="ar">العربية</a>
              </span>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>
