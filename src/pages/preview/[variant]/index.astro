---
import { VARIANTS, type VariantId } from '../../../config';
import { variantComponents } from '../../../variants';

export function getStaticPaths() {
  return Object.keys(VARIANTS).map((variant) => ({ params: { variant } }));
}
const id = Astro.params.variant as VariantId;
const Home = variantComponents[id];
---

<Home lang="en" base={`/preview/${id}`} noindex />
