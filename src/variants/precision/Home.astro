---
/**
 * Precision — light, editorial, calm. No WebGL and no animation library: the hero mark draws
 * itself with CSS clip-path/stroke transitions, sections fade in on scroll (IntersectionObserver).
 * See VARIANT.md.
 */
import { Picture, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/shared/ContactForm.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Footer from './Footer.astro';
import { getDict } from '../../i18n';
import { clients, company, serviceImages, work, type ServiceId } from '../../lib/site';
import type { VariantProps } from '../index';
import './precision.css';

const { lang, base, noindex } = Astro.props as VariantProps;
const t = getDict(lang);

// Client logos are black-on-transparent PNGs; used as CSS masks so they can take any tint.
const clientMasks = await Promise.all(
  clients.map(async (c) => ({ ...c, mask: (await getImage({ src: c.logo, format: 'webp', height: 120 })).src })),
);

const whyIcons = [
  // crosshair — tailored, fitted to you
  'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0-5a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0-13v4m0 10v4M3 12h4m10 0h4',
  // people — team
  'M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm-6 9.5c0-3.3 2.7-6 6-6s6 2.7 6 6M16.5 4.3a3.5 3.5 0 0 1 0 6.4M18.5 14.9c1.5.9 2.5 2.6 2.5 4.6',
  // connected nodes — end to end
  'M5 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm14 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM5 7v6a4 4 0 0 0 4 4h8M12 21l4-4-4-4',
  // shield check — quality
  'M12 3 4.5 6v5.5c0 4.6 3.2 8.3 7.5 9.5 4.3-1.2 7.5-4.9 7.5-9.5V6L12 3Zm-3.5 9 2.5 2.5 4.5-5',
];
---

<Base lang={lang} base={base} noindex={noindex} themeColor="#ffffff" colorScheme="light" bodyClass="v-precision">
  <Header lang={lang} base={base} />

  <main id="main">
    <Hero lang={lang} />

    <!-- About: what we do + mission -->
    <section id="about" class="relative border-t border-line bg-mist py-24 sm:py-32">
      <div class="wrap">
        <p class="kicker" data-reveal>{t.intro.kicker}</p>
        <h2 class="mt-6 max-w-[58rem] text-[clamp(1.75rem,4vw,3.25rem)] leading-[1.12] font-semibold tracking-[-0.03em] text-balance" data-reveal style="--d:1">
          {t.intro.title}
        </h2>
        <div class="mt-16 grid gap-10 border-t border-line-strong pt-10 lg:grid-cols-12">
          <h3 class="text-xl font-semibold text-navy lg:col-span-4" data-reveal>{t.mission.title}</h3>
          <div class="grid gap-6 md:grid-cols-2 lg:col-span-8">
            {t.mission.body.map((p, i) => <p class="leading-relaxed text-ink-2" data-reveal style={`--d:${i + 1}`}>{p}</p>)}
          </div>
        </div>
      </div>
    </section>

    <!-- Why -->
    <section class="py-24 sm:py-32" aria-labelledby="why-title">
      <div class="wrap grid gap-14 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="kicker" data-reveal>{t.why.kicker}</p>
          <h2 id="why-title" class="h-section mt-6" data-reveal style="--d:1">{t.why.title}</h2>
          {t.why.body.map((p, i) => <p class="mt-6 leading-relaxed text-ink-2" data-reveal style={`--d:${i + 2}`}>{p}</p>)}
        </div>
        <ol class="grid self-start border-s border-t border-line sm:grid-cols-2 lg:col-span-7">
          {
            t.why.items.map((item, i) => (
              <li class="group border-e border-b border-line p-7 transition-colors duration-500 hover:bg-mist sm:p-8" data-reveal style={`--d:${i}`}>
                <div class="flex items-center justify-between">
                  <svg class="size-7 text-navy" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d={whyIcons[i]} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span class="font-mono text-xs text-mute ltr-isolate">0{i + 1}</span>
                </div>
                <h3 class="mt-8 text-lg font-semibold text-ink">{item.title}</h3>
                <p class="mt-3 text-[0.95rem] leading-relaxed text-mute">{item.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Services -->
    <section id="services" class="border-t border-line bg-mist py-24 sm:py-32">
      <div class="wrap">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-6">
            <p class="kicker" data-reveal>{t.services.kicker}</p>
            <h2 class="h-section mt-6" data-reveal style="--d:1">{t.services.title}</h2>
          </div>
          <p class="lede lg:col-span-6" data-reveal style="--d:2">{t.services.intro}</p>
        </div>

        <ul class="mt-16 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {
            t.services.items.map((svc, i) => {
              const img = serviceImages[svc.id as ServiceId];
              return (
                <li class="card flex flex-col overflow-hidden" data-reveal style={`--d:${i % 3}`}>
                  <div class="relative grid h-52 place-items-center overflow-hidden bg-[radial-gradient(120%_90%_at_50%_100%,#e8eefc_0%,#f7f9fe_60%,#fff_100%)]">
                    {img ? (
                      <Picture src={img} alt="" widths={[260, 400]} sizes="(min-width: 1024px) 260px, 60vw" formats={['avif', 'webp']} class="h-44 w-auto object-contain" loading="lazy" />
                    ) : (
                      <svg viewBox="0 0 240 140" class="h-36 w-auto" aria-hidden="true">
                        <rect x="20" y="16" width="200" height="108" rx="12" fill="#fff" stroke="#c9d0e2" />
                        <path d="M38 76h38l10-26 16 50 12-36 8 12h40" fill="none" stroke="#31b3ed" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
                        <circle cx="182" cy="76" r="16" fill="#22338e" />
                        <path d="m174 76 6 6 10-12" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    )}
                  </div>
                  <div class="flex flex-1 flex-col border-t border-line p-7">
                    <span class="font-mono text-xs text-mute ltr-isolate">{String(i + 1).padStart(2, '0')}</span>
                    <h3 class="mt-3 text-[1.2rem] font-semibold text-ink">{svc.title}</h3>
                    <p class="mt-3 text-[0.95rem] leading-relaxed text-mute">{svc.body}</p>
                  </div>
                </li>
              );
            })
          }
        </ul>
      </div>
    </section>

    <!-- Work -->
    <section id="work" class="py-24 sm:py-32">
      <div class="wrap">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-6">
            <p class="kicker" data-reveal>{t.work.kicker}</p>
            <h2 class="h-section mt-6" data-reveal style="--d:1">{t.work.title}</h2>
          </div>
          <p class="lede lg:col-span-6" data-reveal style="--d:2">{t.work.body}</p>
        </div>

        <ul class="mt-16 grid gap-x-8 gap-y-14 md:grid-cols-2">
          {
            work.map((w, i) => {
              const copy = t.work.items[w.id];
              return (
                <li class="group" data-reveal style={`--d:${i % 2}`}>
                  <div class="browser transition-transform duration-700 group-hover:-translate-y-1" dir="ltr">
                    <div class="browser-bar" aria-hidden="true">
                      <i /><i /><i />
                      <span class="ms-3 h-5 flex-1 rounded-md bg-mist" />
                    </div>
                    <div class="aspect-[16/10] overflow-hidden">
                      <Picture
                        src={w.shot}
                        alt={`${w.name} — ${copy.tag}`}
                        widths={[480, 720, 1000]}
                        sizes="(min-width: 768px) 560px, 92vw"
                        formats={['avif', 'webp']}
                        class="h-full w-full object-cover object-top transition-transform duration-[1.2s] ease-out group-hover:scale-[1.03]"
                        loading="lazy"
                      />
                    </div>
                  </div>
                  <div class="mt-6 flex items-start gap-4">
                    <div class="grid size-12 shrink-0 place-items-center overflow-hidden rounded-xl border border-line bg-paper p-1.5">
                      <Picture src={w.logo} alt="" widths={[96]} formats={['webp']} class="h-full w-full object-contain" loading="lazy" />
                    </div>
                    <div>
                      <p class="text-xs font-semibold tracking-[0.12em] text-sky-ink uppercase">{copy.tag}</p>
                      <h3 class="mt-1 text-xl font-semibold text-ink" lang="en">{w.name}</h3>
                      <p class="mt-2 leading-relaxed text-mute">{copy.summary}</p>
                    </div>
                  </div>
                </li>
              );
            })
          }
        </ul>
      </div>
    </section>

    <!-- Clients -->
    <section id="clients" class="border-t border-line py-24 sm:py-28">
      <div class="wrap">
        <div class="mx-auto max-w-2xl text-center">
          <p class="kicker justify-center" data-reveal>{t.clients.kicker}</p>
          <h2 class="h-section mt-6" data-reveal style="--d:1">{t.clients.title}</h2>
          <p class="lede mt-6" data-reveal style="--d:2">{t.clients.body}</p>
        </div>
        <ul class="mt-14 grid grid-cols-2 border-s border-t border-line sm:grid-cols-3 lg:grid-cols-6" data-reveal>
          {
            clientMasks.map((c) => (
              <li class="client-cell grid h-32 place-items-center border-e border-b border-line px-6">
                <span class="client-logo" role="img" aria-label={c.name} style={`--logo:url(${c.mask})`} />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- CTA band -->
    <section class="relative overflow-hidden bg-navy-deep py-20 text-white" aria-labelledby="cta-title">
      <div class="cta-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="wrap relative flex flex-col items-start gap-8 md:flex-row md:items-center md:justify-between">
        <h2 id="cta-title" class="max-w-2xl text-[clamp(1.75rem,3.6vw,2.75rem)] leading-[1.1] font-semibold tracking-[-0.03em]">{t.ctaBand.title}</h2>
        <a class="btn btn-light shrink-0" href="#contact">
          {t.ctaBand.button}
          <svg class="arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </a>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="py-24 sm:py-32">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <div class="lg:sticky lg:top-28">
            <p class="kicker" data-reveal>{t.faq.kicker}</p>
            <h2 class="h-section mt-6" data-reveal style="--d:1">{t.faq.title}</h2>
          </div>
        </div>
        <div class="border-t border-line lg:col-span-8">
          {
            t.faq.items.map((item, i) => (
              <details class="faq-item border-b border-line" name="faq" open={i === 0}>
                <summary>
                  <span>{item.q}</span>
                  <span class="plus" aria-hidden="true" />
                </summary>
                <p class="answer">{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="border-t border-line bg-mist py-24 sm:py-32">
      <div class="wrap grid gap-14 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="kicker" data-reveal>{t.contact.kicker}</p>
          <h2 class="h-section mt-6" data-reveal style="--d:1">{t.contact.title}</h2>
          <ul class="mt-10 grid gap-4">
            {
              t.contact.pillars.map((p, i) => (
                <li class="flex items-center gap-4 text-lg text-ink-2" data-reveal style={`--d:${i + 2}`}>
                  <span class="grid size-8 shrink-0 place-items-center rounded-full bg-navy text-white">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="m3 7 2.5 2.5L11 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </span>
                  <span>{p.a} <strong class="font-semibold text-ink">{p.b}</strong></span>
                </li>
              ))
            }
          </ul>
          <div class="mt-12 border-t border-line-strong pt-8" data-reveal>
            <p class="text-sm font-semibold text-mute">{t.contact.direct}</p>
            <p class="mt-3 grid gap-1 text-lg">
              <a class="font-semibold text-navy hover:underline ltr-isolate justify-self-start" href={`mailto:${company.email}`}>{company.email}</a>
              <a class="font-semibold text-navy hover:underline ltr-isolate justify-self-start" href={`tel:${company.phoneHref}`}>{company.phone}</a>
            </p>
          </div>
        </div>
        <div class="lg:col-span-7">
          <div class="rounded-[1.5rem] border border-line bg-paper p-6 shadow-[0_32px_64px_-40px_rgb(14_21_48/0.35)] sm:p-10" data-reveal>
            <p class="text-sm font-semibold text-sky-ink">{t.contact.form.kicker}</p>
            <h3 class="mt-2 mb-8 text-2xl font-semibold tracking-tight text-ink">{t.contact.form.title}</h3>
            <ContactForm lang={lang} />
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Base>

<style>
  .client-logo {
    display: block;
    width: 100%;
    height: 4rem;
    background-color: var(--color-mute);
    mask: var(--logo) center / contain no-repeat;
    -webkit-mask: var(--logo) center / contain no-repeat;
    opacity: 0.9;
    transition:
      background-color 0.4s var(--ease-precise),
      opacity 0.4s var(--ease-precise);
  }
  .client-cell:hover .client-logo {
    background-color: var(--color-navy);
    opacity: 1;
  }
  .cta-grid {
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.07) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.07) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: linear-gradient(90deg, transparent, #000 40%, #000 60%, transparent);
  }
</style>

<script>
  import { initAnchorLinks, reducedMotion } from '../../lib/motion';

  initAnchorLinks(80);

  // Header background once the page scrolls.
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const onScroll = () => (header.dataset.scrolled = String(window.scrollY > 8));
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Reveal on scroll.
  const revealIO = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('is-in');
          revealIO.unobserve(e.target);
        }
      }
    },
    { rootMargin: '0px 0px -8% 0px' },
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => revealIO.observe(el));

  // Hero drawing.
  const mark = document.querySelector<HTMLElement>('[data-mark]');
  if (mark) requestAnimationFrame(() => requestAnimationFrame(() => mark.classList.add('is-drawn')));

  // Current section in the nav.
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')].map((a) => [a.dataset.nav!, a]));
  const navIO = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        const link = links.get(e.target.id);
        if (!link) continue;
        if (e.isIntersecting) {
          links.forEach((l) => l.removeAttribute('aria-current'));
          link.setAttribute('aria-current', 'true');
        }
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  links.forEach((_, id) => {
    const section = document.getElementById(id);
    if (section) navIO.observe(section);
  });

  // Promise rail: the highlight moves every few seconds; pausable (WCAG 2.2.2).
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  if (rail) {
    const items = [...rail.querySelectorAll<HTMLElement>('[data-promise]')];
    const toggle = rail.querySelector<HTMLButtonElement>('[data-rail-toggle]')!;
    const label = toggle.querySelector<HTMLElement>('[data-rail-label]')!;
    const DURATION = 6000;
    rail.style.setProperty('--promise-ms', `${DURATION}ms`);
    let active = 0;
    let timer = 0;
    let userPaused = false;
    let hoverPaused = false;

    const setActive = (i: number) => {
      active = i;
      items.forEach((el, j) => (el.dataset.active = String(j === i)));
    };
    const schedule = () => {
      clearTimeout(timer);
      if (userPaused || hoverPaused) return;
      timer = window.setTimeout(() => {
        setActive((active + 1) % items.length);
        schedule();
      }, DURATION);
    };
    const syncPaused = () => {
      rail.dataset.paused = String(userPaused || hoverPaused);
      // Restart the bar animation from zero when resuming so it matches the timer.
      if (!(userPaused || hoverPaused)) setActive(active), restartBar();
      schedule();
    };
    const restartBar = () => {
      const bar = items[active].querySelector<HTMLElement>('.bar');
      if (!bar) return;
      bar.style.animation = 'none';
      void bar.offsetWidth;
      bar.style.animation = '';
    };

    if (reducedMotion()) {
      toggle.hidden = true;
      items.forEach((el) => (el.dataset.active = 'false'));
    } else {
      items.forEach((el, i) => {
        el.addEventListener('mouseenter', () => {
          hoverPaused = true;
          setActive(i);
          syncPaused();
        });
        el.addEventListener('mouseleave', () => {
          hoverPaused = false;
          syncPaused();
        });
      });
      toggle.addEventListener('click', () => {
        userPaused = !userPaused;
        label.textContent = userPaused ? toggle.dataset.labelPlay! : toggle.dataset.labelPause!;
        toggle.querySelector('[data-icon-pause]')!.toggleAttribute('hidden', userPaused);
        toggle.querySelector('[data-icon-play]')!.toggleAttribute('hidden', !userPaused);
        syncPaused();
      });
      schedule();
    }
  }

  // Mobile menu.
  const panel = document.querySelector<HTMLElement>('[data-menu]')!;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]')!;
  const closeBtn = panel.querySelector<HTMLButtonElement>('[data-menu-close]')!;
  const open = () => {
    panel.hidden = false;
    openBtn.setAttribute('aria-expanded', 'true');
    document.documentElement.style.overflow = 'hidden';
    closeBtn.focus();
  };
  const close = (returnFocus = true) => {
    panel.hidden = true;
    openBtn.setAttribute('aria-expanded', 'false');
    document.documentElement.style.overflow = '';
    if (returnFocus) openBtn.focus();
  };
  openBtn.addEventListener('click', open);
  closeBtn.addEventListener('click', () => close());
  panel.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
    if (e.key === 'Tab') {
      // Keep focus inside the panel.
      const f = [...panel.querySelectorAll<HTMLElement>('a, button')];
      const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) (e.preventDefault(), last.focus());
      else if (!e.shiftKey && document.activeElement === last) (e.preventDefault(), first.focus());
    }
  });
  panel.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => close(false)));
</script>
