---
/**
 * Variant "Build" — code-forward: a product getting built in front of you.
 * code → UI → API → tested release. GSAP-heavy, no WebGL. See VARIANT.md.
 */
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/shared/ContactForm.astro';
import Header from './components/Header.astro';
import Hero from './components/Hero.astro';
import Stages from './components/Stages.astro';
import Footer from './components/Footer.astro';
import { getDict } from '../../i18n';
import { clients, company, work } from '../../lib/site';
import { strings } from './strings';
import type { VariantProps } from '../index';
import '@fontsource-variable/sora';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/ibm-plex-sans-arabic/400.css';
import '@fontsource/ibm-plex-sans-arabic/500.css';
import '@fontsource/ibm-plex-sans-arabic/600.css';
import '@fontsource/ibm-plex-sans-arabic/700.css';
import './build.css';

const { lang, base, noindex } = Astro.props as VariantProps;
const t = getDict(lang);
const s = strings(lang);

const whyIcons = [
  // tailored: puzzle piece
  'M9 3h4a2 2 0 0 1 4 0h2v5a2 2 0 0 1 0 4v5h-5a2 2 0 0 0-4 0H5v-5a2 2 0 0 0 0-4V3z',
  // team
  'M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 6.5M18.5 14.5a6.5 6.5 0 0 1 3 5.5',
  // end-to-end: flow
  'M4 6h5v4H4zM15 14h5v4h-5zM6.5 10v3a1 1 0 0 0 1 1H15M15 6h5v4h-5zM9 8h6',
  // quality: shield check
  'M12 3l8 3v6c0 4.5-3.4 8.1-8 9-4.6-.9-8-4.5-8-9V6zM8.5 12l2.5 2.5 4.5-5',
];
---

<Base lang={lang} base={base} noindex={noindex} themeColor="#F5F6FA" colorScheme="light" bodyClass="v-build">
  <script is:inline slot="head">
    // Decide before first paint whether intro animations will run; if the module never
    // arrives (blocked, very slow), fall back to the final, fully visible state after 4 s.
    (function () {
      var d = document.documentElement;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      d.classList.add('bt-motion');
      setTimeout(function () {
        if (!d.classList.contains('bt-ready')) d.classList.remove('bt-motion');
      }, 4000);
    })();
  </script>

  <Header lang={lang} base={base} />

  <main id="main">
    <Hero lang={lang} />

    <section class="sec intro" aria-labelledby="intro-title">
      <div class="wrap intro-in">
        <p class="kicker">{t.intro.kicker}</p>
        <h2 id="intro-title" class="intro-title" data-words>{t.intro.title}</h2>
        <p class="intro-body" data-reveal>{t.intro.body}</p>
      </div>
    </section>

    <section id="about" class="sec about" aria-labelledby="about-title">
      <div class="wrap about-in">
        <div class="about-head" data-reveal>
          <p class="kicker">{t.mission.kicker}</p>
          <h2 id="about-title" class="sec-title">{t.mission.title}</h2>
        </div>
        <div class="readme" data-reveal>
          <div class="readme-bar" aria-hidden="true">
            <svg viewBox="0 0 16 16"><path d="M4 1.5h5.5L13 5v9.5H4zM9.5 1.5V5H13" /></svg>
            <span dir="ltr">{s.readme}</span>
          </div>
          <div class="readme-body">
            {t.mission.body.map((p) => <p>{p}</p>)}
          </div>
        </div>
      </div>
    </section>

    <section class="sec why" aria-labelledby="why-title">
      <div class="wrap why-in">
        <div class="why-head" data-reveal>
          <p class="kicker">{t.why.kicker}</p>
          <h2 id="why-title" class="sec-title">{t.why.title}</h2>
          {t.why.body.map((p) => <p class="sec-lead">{p}</p>)}
        </div>
        <ul class="why-grid" data-stagger>
          {
            t.why.items.map((it, i) => (
              <li class="why-card">
                <span class="why-top">
                  <svg class="why-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d={whyIcons[i]} />
                  </svg>
                  <span class="why-idx ltr-isolate" aria-hidden="true">
                    0{i + 1}
                  </span>
                </span>
                <h3>{it.title}</h3>
                <p>{it.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <Stages lang={lang} />

    <section id="work" class="sec work" aria-labelledby="work-title">
      <div class="wrap">
        <header class="sec-head" data-reveal>
          <p class="kicker">{t.work.kicker}</p>
          <h2 id="work-title" class="sec-title">{t.work.title}</h2>
          <p class="sec-lead">{t.work.body}</p>
        </header>
        <ul class="work-grid">
          {
            work.map((w) => {
              const copy = t.work.items[w.id];
              return (
                <li class="proj" data-proj>
                  <div class="frame">
                    <div class="frame-bar" aria-hidden="true">
                      <span class="dots">
                        <i />
                        <i />
                        <i />
                      </span>
                      <span class="frame-url" dir="ltr">
                        {w.name}
                      </span>
                      <span class="frame-load" data-load />
                    </div>
                    <div class="frame-shot" data-shot>
                      <Picture
                        src={w.shot}
                        formats={['avif', 'webp']}
                        widths={[480, 760, 1100]}
                        sizes="(min-width: 1024px) 560px, 92vw"
                        alt={`${w.name} — ${copy.tag}`}
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  </div>
                  <div class="proj-copy">
                    <p class="proj-tag">{copy.tag}</p>
                    <h3>{w.name}</h3>
                    <p>{copy.summary}</p>
                  </div>
                </li>
              );
            })
          }
        </ul>
      </div>
    </section>

    <section id="clients" class="sec clients" aria-labelledby="clients-title">
      <div class="wrap clients-in">
        <div class="clients-head" data-reveal>
          <p class="kicker">{t.clients.kicker}</p>
          <h2 id="clients-title" class="sec-title">{t.clients.title}</h2>
          <p class="sec-lead">{t.clients.body}</p>
        </div>
        <ul class="logo-grid" data-stagger>
          {
            clients.map((c) => (
              <li>
                <Picture src={c.logo} formats={['avif', 'webp']} widths={[160, 320]} sizes="160px" alt={c.name} loading="lazy" />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="cta" aria-labelledby="cta-title">
      <div class="wrap">
        <div class="cta-panel">
          <svg class="cta-beat" viewBox="0 0 600 60" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0 34h120l8 6 16-32 20 44 12-18h88l8 6 16-32 20 44 12-18h88l8 6 16-32 20 44 12-18h136" />
          </svg>
          <p class="cta-prompt" dir="ltr" aria-hidden="true">
            <span class="cta-ps">$</span>
            <span class="cta-cmd" data-cmd>bitech init --your-business</span>
            <span class="cta-caret"></span>
          </p>
          <h2 id="cta-title" class="cta-title">{t.ctaBand.title}</h2>
          <a class="btn btn-sky" href="#contact">
            {t.ctaBand.button}
            <svg class="btn-arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" /></svg>
          </a>
        </div>
      </div>
    </section>

    <section id="faq" class="sec faq" aria-labelledby="faq-title">
      <div class="wrap faq-in">
        <div class="faq-head" data-reveal>
          <p class="kicker">{t.faq.kicker}</p>
          <h2 id="faq-title" class="sec-title">{t.faq.title}</h2>
        </div>
        <div class="faq-list" data-stagger>
          {
            t.faq.items.map((f) => (
              <details class="qa">
                <summary>
                  <span>{f.q}</span>
                  <span class="qa-icon" aria-hidden="true" />
                </summary>
                <div class="qa-a">
                  <p>{f.a}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section id="contact" class="contact" aria-labelledby="contact-title">
      <div class="wrap contact-in">
        <div class="contact-copy" data-reveal>
          <p class="kicker kicker--dark">{t.contact.kicker}</p>
          <h2 id="contact-title" class="contact-title">{t.contact.title}</h2>
          <ul class="pillars">
            {
              t.contact.pillars.map((p) => (
                <li>
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M3 8.5l3.2 3L13 4.5" />
                  </svg>
                  <span>
                    {p.a} <strong>{p.b}</strong>
                  </span>
                </li>
              ))
            }
          </ul>
          <div class="direct">
            <p class="direct-k">{t.contact.direct}</p>
            <a class="ltr-isolate" href={`mailto:${company.email}`}>{company.email}</a>
            <a class="ltr-isolate" href={`tel:${company.phoneHref}`}>{company.phone}</a>
          </div>
        </div>
        <div class="form-card" data-reveal>
          <p class="form-kicker">{t.contact.form.kicker}</p>
          <h3 class="form-title">{t.contact.form.title}</h3>
          <ContactForm lang={lang} />
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />

  <script>
    import './scripts/main';
  </script>
</Base>
