---
/**
 * Variant "Connect" — dark. The services as a living system of connected parts.
 * See VARIANT.md for the motion plan, budgets and fallbacks.
 */
import { Picture, Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Logo from '../../components/shared/Logo.astro';
import ContactForm from '../../components/shared/ContactForm.astro';
import HeroNetwork from './HeroNetwork.astro';
import ServiceDiagram from './ServiceDiagram.astro';
import Icon from './Icon.astro';
import { getDict, homePath, otherLang } from '../../i18n';
import { navItems } from '../../lib/nav';
import { clients, work, company, serviceImages, social } from '../../lib/site';
import type { VariantProps } from '../index';
import './connect.css';

const { lang, base, noindex } = Astro.props as VariantProps;
const t = getDict(lang);
const nav = navItems(t);
const home = homePath(lang, base);
const alt = homePath(otherLang(lang), base);
const [lead, ...rotating] = t.hero.slides;
const year = new Date().getFullYear();
const whyIcons = ['puzzle', 'team', 'flow', 'shield'] as const;
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base lang={lang} base={base} noindex={noindex} themeColor="#050817" colorScheme="dark" bodyClass="v-connect">
  <header class="cx-header" data-header>
    <div class="cx-wrap cx-header-inner">
      <a class="cx-brand" href={home} aria-label={company.brand}>
        <Logo tone="onDark" class="cx-brand-logo" title="" />
      </a>

      <nav class="cx-nav" aria-label={t.a11y.primaryNav}>
        <ul>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>

      <div class="cx-header-actions">
        <a class="cx-lang" href={alt} hreflang={t.langSwitch.hreflang} lang={t.langSwitch.hreflang} aria-label={t.langSwitch.aria}>
          {t.langSwitch.label}
        </a>
        <a class="cx-btn cx-btn--primary cx-btn--sm cx-header-cta" href="#contact">{t.nav.cta}</a>
        <button class="cx-menu-btn" type="button" aria-expanded="false" aria-controls="cx-menu" data-menu-open data-label-close={t.a11y.closeMenu}>
          <span class="sr-only">{t.a11y.menu}</span>
          <span class="cx-menu-icon" aria-hidden="true"><span></span><span></span></span>
        </button>
      </div>
    </div>

    <div class="cx-menu" id="cx-menu" data-menu hidden>
      <nav aria-label={t.a11y.primaryNav}>
        <ul>
          {nav.map((n, i) => <li><a href={n.href} data-menu-link><span class="cx-mono">{pad(i + 1)}</span>{n.label}</a></li>)}
        </ul>
      </nav>
      <div class="cx-menu-foot">
        <a class="cx-btn cx-btn--primary" href="#contact" data-menu-link>{t.nav.cta}</a>
        <a class="cx-lang" href={alt} hreflang={t.langSwitch.hreflang} lang={t.langSwitch.hreflang} aria-label={t.langSwitch.aria}>{t.langSwitch.label}</a>
      </div>
    </div>
  </header>

  <main id="main">
    <!-- HERO -->
    <section class="cx-hero" aria-labelledby="hero-title">
      <div class="cx-hero-bg" aria-hidden="true">
        <HeroNetwork />
        <canvas class="cx-hero-canvas" data-hero-canvas></canvas>
        <div class="cx-hero-vignette"></div>
      </div>

      <div class="cx-wrap cx-hero-inner">
        <p class="cx-eyebrow" data-hero-in><span class="cx-dot" aria-hidden="true"></span>{t.hero.eyebrow}</p>
        <h1 id="hero-title" class="cx-hero-title" data-hero-in>{lead.title}</h1>
        <p class="cx-hero-lead" data-hero-in>{lead.text}</p>
        <div class="cx-hero-ctas" data-hero-in>
          <a class="cx-btn cx-btn--primary" href="#contact">{t.hero.cta}<Icon name="arrow" class="cx-btn-icon" /></a>
          <a class="cx-btn cx-btn--ghost" href="#work">{t.hero.ctaSecondary}</a>
        </div>

        <div class="cx-signal" data-signal data-hero-in>
          <div class="cx-signal-tabs" role="tablist" aria-label={t.hero.eyebrow}>
            {
              rotating.map((_, i) => (
                <button
                  type="button"
                  role="tab"
                  id={`sig-tab-${i}`}
                  aria-controls={`sig-panel-${i}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                  data-signal-tab={i}
                >
                  <span class="cx-mono">{pad(i + 2)}</span>
                  <span class="cx-signal-bar"><span></span></span>
                </button>
              ))
            }
            <button type="button" class="cx-signal-pause" data-signal-pause aria-pressed="false" data-label-pause={t.a11y.pause} data-label-play={t.a11y.play}>
              <span class="sr-only">{t.a11y.pause}</span>
              <svg viewBox="0 0 16 16" aria-hidden="true" class="cx-ico-pause"><rect x="4" y="3" width="2.5" height="10" rx="1" /><rect x="9.5" y="3" width="2.5" height="10" rx="1" /></svg>
              <svg viewBox="0 0 16 16" aria-hidden="true" class="cx-ico-play"><path d="M5 3.2v9.6a.6.6 0 0 0 .9.5l7.6-4.8a.6.6 0 0 0 0-1L5.9 2.7a.6.6 0 0 0-.9.5Z" /></svg>
            </button>
          </div>
          <div class="cx-signal-panels">
            {
              rotating.map((s, i) => (
                <div class="cx-signal-panel" role="tabpanel" id={`sig-panel-${i}`} aria-labelledby={`sig-tab-${i}`} data-signal-panel={i} data-active={i === 0 ? 'true' : 'false'}>
                  <h2 class="cx-signal-title">{s.title}</h2>
                  <p>{s.text}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <a class="cx-scroll-cue" href="#intro" aria-hidden="true" tabindex="-1"><span></span></a>
    </section>

    <!-- INTRO -->
    <section class="cx-section cx-intro" id="intro">
      <div class="cx-wrap cx-intro-grid">
        <p class="cx-kicker" data-reveal>{t.intro.kicker}</p>
        <div>
          <h2 class="cx-statement" data-reveal>{t.intro.title}</h2>
          <p class="cx-intro-body" data-reveal>{t.intro.body}</p>
        </div>
      </div>
    </section>

    <!-- ABOUT / MISSION -->
    <section class="cx-section cx-mission" id="about" aria-labelledby="about-title">
      <div class="cx-wrap">
        <div class="cx-pulse-rule" aria-hidden="true">
          <svg viewBox="0 0 1200 80" preserveAspectRatio="none"><path pathLength="1" d="M0 40 H470 L500 40 L530 6 L566 74 L596 40 H640 L660 40 A14 14 0 1 0 688 40 H1200" /></svg>
        </div>
        <div class="cx-mission-grid">
          <div>
            <p class="cx-kicker" data-reveal>{t.mission.kicker}</p>
            <h2 id="about-title" class="cx-h2" data-reveal>{t.mission.title}</h2>
          </div>
          <div class="cx-mission-body">
            {t.mission.body.map((p) => <p data-reveal>{p}</p>)}
          </div>
        </div>
      </div>
    </section>

    <!-- WHY -->
    <section class="cx-section cx-why" aria-labelledby="why-title">
      <div class="cx-wrap">
        <div class="cx-section-head">
          <p class="cx-kicker" data-reveal>{t.why.kicker}</p>
          <h2 id="why-title" class="cx-h2" data-reveal>{t.why.title}</h2>
          <div class="cx-section-sub">
            {t.why.body.map((p) => <p data-reveal>{p}</p>)}
          </div>
        </div>
        <ul class="cx-why-grid" role="list">
          {
            t.why.items.map((item, i) => (
              <li class="cx-card cx-why-card" data-reveal data-glow>
                <span class="cx-why-icon"><Icon name={whyIcons[i]} /></span>
                <span class="cx-mono cx-why-num">{pad(i + 1)}</span>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="cx-section cx-services" id="services" aria-labelledby="services-title">
      <div class="cx-wrap">
        <div class="cx-section-head">
          <p class="cx-kicker" data-reveal>{t.services.kicker}</p>
          <h2 id="services-title" class="cx-h2" data-reveal>{t.services.title}</h2>
          <div class="cx-section-sub"><p data-reveal>{t.services.intro}</p></div>
        </div>
      </div>

      <div class="cx-svc-stage" data-svc-stage style={`--svc-count: ${t.services.items.length}`}>
        <div class="cx-svc-sticky">
          <div class="cx-wrap cx-svc-grid">
            <div class="cx-svc-diagram" aria-hidden="true">
              <ServiceDiagram ids={t.services.items.map((s) => s.id)} />
            </div>
            <div class="cx-svc-panel">
              <div class="cx-svc-progress" aria-hidden="true">
                <span class="cx-mono" data-svc-current>01</span>
                <span class="cx-svc-track"><span data-svc-bar></span></span>
                <span class="cx-mono">{pad(t.services.items.length)}</span>
              </div>
              <ol class="cx-svc-list" role="list">
                {
                  t.services.items.map((s, i) => {
                    const img = serviceImages[s.id as keyof typeof serviceImages];
                    return (
                      <li class="cx-svc-item" data-svc-item={i} data-active={i === 0 ? 'true' : 'false'}>
                        <div class="cx-svc-meta">
                          <span class="cx-svc-icon"><Icon name={s.id} /></span>
                          <span class="cx-mono">{pad(i + 1)}</span>
                        </div>
                        <h3>{s.title}</h3>
                        <p>{s.body}</p>
                        {img && (
                          <div class="cx-svc-img">
                            <Image src={img} alt="" widths={[240, 400]} sizes="(min-width: 1024px) 240px, 50vw" loading="lazy" />
                          </div>
                        )}
                      </li>
                    );
                  })
                }
              </ol>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CLIENTS -->
    <section class="cx-section cx-clients" id="clients" aria-labelledby="clients-title">
      <div class="cx-wrap">
        <div class="cx-section-head cx-section-head--center">
          <p class="cx-kicker" data-reveal>{t.clients.kicker}</p>
          <h2 id="clients-title" class="cx-h2" data-reveal>{t.clients.title}</h2>
          <div class="cx-section-sub"><p data-reveal>{t.clients.body}</p></div>
        </div>
        <ul class="cx-logos" role="list">
          {
            clients.map((c) => (
              <li>
                <Image src={c.logo} alt={c.name} height={64} densities={[1, 2]} loading="lazy" class="cx-logo-img" />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- CTA BAND -->
    <section class="cx-cta" aria-labelledby="cta-title">
      <div class="cx-wrap">
        <div class="cx-cta-card" data-reveal>
          <svg class="cx-cta-arcs" viewBox="0 0 200 200" aria-hidden="true">
            <path d="M40 30 A130 130 0 0 1 170 160" /><path d="M40 70 A90 90 0 0 1 130 160" /><path d="M40 110 A50 50 0 0 1 90 160" />
          </svg>
          <h2 id="cta-title">{t.ctaBand.title}</h2>
          <a class="cx-btn cx-btn--primary" href="#contact">{t.ctaBand.button}<Icon name="arrow" class="cx-btn-icon" /></a>
        </div>
      </div>
    </section>

    <!-- WORK -->
    <section class="cx-section cx-work" id="work" aria-labelledby="work-title">
      <div class="cx-wrap">
        <div class="cx-section-head">
          <p class="cx-kicker" data-reveal>{t.work.kicker}</p>
          <h2 id="work-title" class="cx-h2" data-reveal>{t.work.title}</h2>
          <div class="cx-section-sub"><p data-reveal>{t.work.body}</p></div>
        </div>
        <ul class="cx-work-grid" role="list">
          {
            work.map((w) => {
              const copy = t.work.items[w.id];
              return (
                <li class="cx-work-item" data-reveal>
                  <article class="cx-work-card" data-tilt>
                    <div class="cx-browser">
                      <div class="cx-browser-bar" aria-hidden="true">
                        <span class="cx-browser-dots"><i></i><i></i><i></i></span>
                        <span class="cx-browser-url">{w.name}</span>
                      </div>
                      <div class="cx-browser-shot">
                        <Picture
                          src={w.shot}
                          formats={['avif', 'webp']}
                          widths={[480, 760, 1100]}
                          sizes="(min-width: 960px) 560px, 92vw"
                          alt={lang === 'ar' ? `لقطة من موقع ${w.name}` : `${w.name} website`}
                          loading="lazy"
                        />
                      </div>
                    </div>
                    <div class="cx-work-copy">
                      <p class="cx-work-tag cx-mono">{copy.tag}</p>
                      <h3>{w.name}</h3>
                      <p>{copy.summary}</p>
                    </div>
                  </article>
                </li>
              );
            })
          }
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class="cx-section cx-faq" id="faq" aria-labelledby="faq-title">
      <div class="cx-wrap cx-faq-grid">
        <div class="cx-faq-head">
          <p class="cx-kicker" data-reveal>{t.faq.kicker}</p>
          <h2 id="faq-title" class="cx-h2" data-reveal>{t.faq.title}</h2>
        </div>
        <div class="cx-faq-list">
          {
            t.faq.items.map((item, i) => (
              <details class="cx-faq-item" name="cx-faq" open={i === 0} data-reveal>
                <summary>
                  <span class="cx-mono">{pad(i + 1)}</span>
                  <span class="cx-faq-q">{item.q}</span>
                  <span class="cx-faq-toggle" aria-hidden="true"></span>
                </summary>
                <p>{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="cx-section cx-contact" id="contact" aria-labelledby="contact-title">
      <div class="cx-contact-glow" aria-hidden="true"></div>
      <div class="cx-wrap cx-contact-grid">
        <div class="cx-contact-copy">
          <p class="cx-kicker" data-reveal>{t.contact.kicker}</p>
          <h2 id="contact-title" class="cx-contact-title" data-reveal>{t.contact.title}</h2>
          <ul class="cx-pillars" role="list">
            {t.contact.pillars.map((p) => <li data-reveal><span>{p.a}</span> <strong>{p.b}</strong></li>)}
          </ul>
          <div class="cx-direct" data-reveal>
            <p class="cx-direct-label">{t.contact.direct}</p>
            <a href={`mailto:${company.email}`}><Icon name="mail" /><span class="ltr-isolate">{company.email}</span></a>
            <a href={`tel:${company.phoneHref}`}><Icon name="phone" /><span class="ltr-isolate">{company.phone}</span></a>
          </div>
        </div>
        <div class="cx-form-card" data-reveal>
          <p class="cx-kicker">{t.contact.form.kicker}</p>
          <h3 class="cx-form-title">{t.contact.form.title}</h3>
          <ContactForm lang={lang} />
        </div>
      </div>
    </section>
  </main>

  <footer class="cx-footer">
    <div class="cx-wrap">
      <div class="cx-footer-top">
        <div class="cx-footer-brand">
          <Logo tone="onDark" class="cx-footer-logo" />
          <p class="cx-tagline">
            {t.tagline.lead} <span class="cx-sky">{t.tagline.business}</span> {t.tagline.meets} <span class="cx-sky-soft">{t.tagline.precision}</span>
          </p>
          <div class="cx-footer-contact">
            <a href={`mailto:${company.email}`}><span class="cx-footer-label">{t.footer.email}</span><span class="ltr-isolate">{company.email}</span></a>
            <a href={`tel:${company.phoneHref}`}><span class="cx-footer-label">{t.footer.phone}</span><span class="ltr-isolate">{company.phone}</span></a>
          </div>
        </div>
        <div class="cx-offices">
          {
            (['kl', 'chennai', 'dubai'] as const).map((id) => {
              const o = t.footer.offices[id];
              return (
                <address class="cx-office">
                  <strong>{o.title}</strong>
                  {o.lines.map((l) => <span>{l}</span>)}
                </address>
              );
            })
          }
        </div>
      </div>
      <div class="cx-footer-bottom">
        <p>
          © <span class="ltr-isolate">{year}</span> {company.legalName} (<span class="ltr-isolate">{company.registration}</span>). {t.footer.rights}
        </p>
        {
          social.length > 0 && (
            <ul class="cx-social" role="list">
              {social.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.id}</a></li>)}
            </ul>
          )
        }
        <a class="cx-top" href="#main">{t.footer.backToTop} ↑</a>
      </div>
    </div>
  </footer>

  <script>
    import { initConnect } from './connect';
    initConnect();
  </script>
</Base>
