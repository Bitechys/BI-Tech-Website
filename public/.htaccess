# Hostinger (LiteSpeed/Apache). Static Astro build: dist/ → public_html/.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www.bitechys.com → bitechys.com (change if the team prefers www).
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # HTTPS on whatever host this is served from (also works on a preview subdomain).
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Pages of the old Angular site. Its routes used "#/" which never reaches the server,
  # so these only catch direct hits on the template's paths; the home page script handles #/ links.
  RewriteRule ^(home|about|menu|contactus|services/.*|help/.*|ourfood/.*)/?$ / [L,R=301]
  RewriteRule ^assets/doc/menu\.pdf$ / [L,R=301]

  # Directory URLs always end with a slash (matches trailingSlash: 'always').
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ /$1/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Astro fingerprints everything in /_astro/ — cache for a year.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>

AddType image/avif .avif
AddType image/webp .webp
AddType font/woff2 .woff2
