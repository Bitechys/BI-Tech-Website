{
  "name": "Bitechys",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "git": "git add . && git commit -m 'update' && git push",
    "oldpredeploy": "ng build --configuration production --base-href https://Bitechys.github.io/BI-Tech-Website/",
    "predeploy": "ng build --configuration production --base-href /",
    "deploy": "gh-pages -d dist/Bitechys",
    "upload": "ng build --configuration production --base-href ./",
    "build:ssr": "ng build && ng run Bitechys:server",
    "serve:ssr": "node dist/Bitechys/server/main.js",
    "dev:ssr": "ng run Bitechys:serve-ssr",
    "prerender": "ng run Bitechys:prerender"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^14.0.0",
    "@angular/common": "^14.0.0",
    "@angular/compiler": "^14.0.0",
    "@angular/core": "^14.0.0",
    "@angular/forms": "^14.0.0",
    "@angular/platform-browser": "^14.0.0",
    "@angular/platform-browser-dynamic": "^14.0.0",
    "@angular/platform-server": "^14.3.0",
    "@angular/router": "^14.0.0",
    "@nguniversal/express-engine": "^14.2.3",
    "aos": "^2.3.4",
    "bootstrap": "^5.3.1",
    "express": "^4.15.2",
    "gh-pages": "^6.3.0",
    "gsap": "^3.12.2",
    "ngx-cookie-service": "^17.1.0",
    "owl-carousel": "^1.0.0",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^14.2.1",
    "@angular/cli": "~14.2.1",
    "@angular/compiler-cli": "^14.0.0",
    "@nguniversal/builders": "^14.2.3",
    "@types/aos": "^3.0.4",
    "@types/express": "^4.17.0",
    "@types/gsap": "^3.0.0",
    "@types/intl-tel-input": "^18.1.4",
    "@types/jasmine": "~4.0.0",
    "@types/node": "^14.15.0",
    "jasmine-core": "~4.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "typescript": "~4.7.2",
    "webpack": "^5.88.2"
  }
}